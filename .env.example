APP_NAME=AlimaProspects
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://alimaprospects.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alimaprospects
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. `log` locally (everything lands in storage/logs); `resend` everywhere that actually
# sends, which is what Outreach (Phase 11) and the Notifications digests go out over.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Must be an address on a domain verified in Resend, or every send is rejected by the provider.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (the mail provider). Required when MAIL_MAILER=resend.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ───────────────────────────────────────────────────────────────
# AlimaProspects — project configuration
# (Horizon runs only on Linux prod/CI; locally use `php artisan queue:work`.)
# For production set QUEUE_CONNECTION=redis, CACHE_STORE=redis, SESSION_DRIVER=redis.
# ───────────────────────────────────────────────────────────────

# Realtime (Reverb) — generate per-environment keys with `php artisan reverb:install`.
# These local defaults are safe for dev; production MUST use unique generated secrets.
REVERB_APP_ID=local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# AI Platform (default provider: Anthropic Claude, behind our AiClient — ADR 0005)
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_URL=https://api.anthropic.com/v1
AI_MODEL_REASONING=claude-sonnet-5-5
AI_MODEL_CHEAP=claude-haiku-5-5
# Per-team monthly AI allowance. 1 credit = AI_MICROS_PER_CREDIT cost micro-units (1000 ≈ $0.001),
# so 100000 credits ≈ $100/month. Replaced by plan allowances in Billing (Phase 16).
AI_MONTHLY_CREDIT_DEFAULT=100000
# AI_MICROS_PER_CREDIT=1000
# Generation + reliability tuning (sensible defaults in config/ai-platform.php):
# AI_MAX_TOKENS=2048
# AI_TEMPERATURE=0.2
# AI_TIMEOUT=60
# AI_SCHEMA_RETRIES=1
# AI_CACHE_ENABLED=true
# AI_CACHE_STORE=
# AI_CACHE_TTL=3600
# Input bounds (Phase 20, ADR 0017), in characters rather than tokens — a token count is only
# knowable by asking the provider, which is the call these exist to avoid. An oversized *untrusted*
# block (a scraped page) is truncated and says so; the whole assembled prompt being over the limit
# is refused outright, before anything is spent. 0 switches either off.
# AI_MAX_PROMPT_CHARS=60000
# AI_MAX_UNTRUSTED_CHARS=20000

# Lead-sourcing & enrichment providers (ADR 0008)
COMPANIES_HOUSE_API_KEY=
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=
# Lead-sourcing run + HTTP tuning (all optional; config/lead-sourcing.php defaults shown)
# LEAD_SOURCING_DEFAULT_LIMIT=25
# LEAD_SOURCING_MAX_LIMIT=100
# Set to false to skip AI query shaping and search the ICP's industry values verbatim.
# LEAD_SOURCING_QUERY_SHAPING=true
# LEAD_SOURCING_CB_THRESHOLD=5
# LEAD_SOURCING_CB_COOLDOWN=60
# COMPANIES_HOUSE_TIMEOUT=10
# COMPANIES_HOUSE_CONNECT_TIMEOUT=5
# COMPANIES_HOUSE_RETRY_TIMES=2
# GOOGLE_PLACES_COST_MICROS=32000   # indicative per Text Search request (~$0.032)
# WEB_SEARCH_COST_MICROS=3000       # indicative per query (~$0.003)
# The AI lead source (Phase 7c) needs no key of its own — it runs on ANTHROPIC_API_KEY through the
# AI Platform, and its cost lands on the ai_requests ledger rather than on the discovery run. The
# one knob is a ceiling on companies per answer, i.e. on output tokens.
# AI_LEAD_SOURCE_MAX_RESULTS=20

# Free lead sources (lead-sources-plan.md, ADR 0025). Every key below is **free to obtain** and
# every source is available on **every plan** — lead and signal quotas are the only limits (ADR 0025
# §7). Nothing here has a value in this file; the spike findings, limits and licence conditions per
# source are in docs/modules/lead-sourcing.md → "Free sources — spike findings (L0)".
#
# A source is only run when it is **implemented, enabled, and holds any key it requires** (L1), so
# an unset key below means "coming soon in the picker", never a failing run.
#
# Food Standards Agency hygiene register (L2) — **no key**: the API is open, but `x-api-version: 2`
# is mandatory and the API returns no data without it. OGL v3; store the rating's own date and never
# render it as a current rating.
# FSA_RATINGS_BASE_URL=https://api.ratings.food.gov.uk
# FSA_RATINGS_TIMEOUT=10
# FSA_RATINGS_ENABLED=true
#
# CQC (L2) — free subscription key from api-portal.service.cqc.org.uk. CQC asks every consumer to
# identify itself with a partner code on every request; it is not a secret, it is a courtesy.
# CQC_API_KEY=
# CQC_PARTNER_CODE=alimaprospects
# CQC_ENABLED=false
#
# FCA Financial Services Register (L2) — free key, email + key headers, ~10 requests / 10 seconds.
# **Blocked on a written answer** about commercial reuse (docs/compliance.md §5): leave disabled
# until that arrives, however valid the key is.
# FCA_REGISTER_EMAIL=
# FCA_REGISTER_API_KEY=
# FCA_REGISTER_ENABLED=false
#
# Charity Commission register (L2) — free key from api-portal.charitycommission.gov.uk after
# subscribing to the Register of Charities product. OGL v3, and its terms require the source to be
# acknowledged on anything we show.
# CHARITY_COMMISSION_API_KEY=
# CHARITY_COMMISSION_ENABLED=false
#
# HM Land Registry CCOD/OCOD (L3) — a **file**, not an API: downloaded from an account on
# use-land-property-data.service.gov.uk and imported by `reference-data:import`. No key exists; what
# gates it is the licence, accepted inside that account. Leave disabled until it has been read.
# LAND_REGISTRY_ENABLED=false
#
# OpenStreetMap / Overpass (L5) — no key. The public endpoint states it is for browser-based and
# human-operated tools, so concurrency is 1 and production volume means **our own instance**: that
# is what this URL is for. ODbL, "© OpenStreetMap contributors", stored on the lead.
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_OVERPASS_TIMEOUT=60
# OSM_OVERPASS_MAX_CONCURRENCY=1
# OSM_ENABLED=false
#
# Companies House **Streaming** API (L7) — a second, separate application from
# COMPANIES_HOUSE_API_KEY above; two concurrent connections per key, and reconnect loops get an
# application banned. It runs as a supervised long-lived worker (ADR 0025 §6), never as a queued
# job, and never on Windows the way production runs it.
# COMPANIES_HOUSE_STREAM_KEY=
# COMPANIES_HOUSE_STREAM_URL=https://stream.company-information.service.gov.uk
# COMPANIES_HOUSE_STREAM_ENABLED=false
#
# Public contracts (L9) — Contracts Finder and Find a Tender, both open OCDS, no key. The highest
# value per request in this plan: an award names its supplier by Companies House number, so a signal
# matches a lead exactly rather than by name.
# CONTRACTS_FINDER_URL=https://www.contractsfinder.service.gov.uk
# FIND_A_TENDER_URL=https://www.find-tender.service.gov.uk
# PUBLIC_CONTRACTS_ENABLED=false
#
# The Gazette (L11) — no key. Corporate notices only (the OGL does not cover personal data) and its
# robots.txt sets Crawl-delay: 10, which this floor exists to honour.
# GAZETTE_BASE_URL=https://www.thegazette.co.uk
# GAZETTE_MIN_REQUEST_INTERVAL_MS=10000
# GAZETTE_ENABLED=false
#
# Dubai Pulse DLD transactions (L12) — market context, never leads: the dataset carries no buyer or
# seller identity. Access is an OAuth client-credentials grant issued per dataset **after a
# permission request**, so both halves arrive together or neither does.
# DUBAI_PULSE_CLIENT_ID=
# DUBAI_PULSE_CLIENT_SECRET=
# DUBAI_PULSE_ENABLED=false
#
# Dropped in L0 and deliberately absent from this file: Adzuna and Reed (job ads — terms forbid or
# do not permit lead generation), PlanIt (robots.txt), DIFC and DMCC (robots.txt), ADGM (no machine
# access). Adding a key for one of those would be the first step of a decision ADR 0025 §4 already
# took; reopen the ADR instead.

# Signals (trigger-event prospecting, ADR 0011). Reuses WEB_SEARCH_API_KEY / WEB_SEARCH_BASE_URL
# above for Serper /news and, since S13a, Serper /search. All below optional;
# config/signals.php defaults shown.
# SIGNALS_SERPER_TIMEOUT=10
# SIGNALS_SERPER_CONNECT_TIMEOUT=5
# SIGNALS_SERPER_RETRY_TIMES=2
# SIGNALS_SERPER_RETRY_SLEEP_MS=250
# SIGNALS_CB_THRESHOLD=5
# SIGNALS_CB_COOLDOWN=60
# SIGNALS_RESULTS_PER_QUERY=20
# SIGNALS_RECENCY=qdr:w             # Serper tbs recency window (past week)
# SIGNALS_HL=en                     # results language (v1: English only)
# SIGNALS_COST_MICROS=1000          # module-wide fallback; the per-source keys below override it
# Per-source price (S13a, ADR 0023). A source is priced separately because one of the sources
# declared for S13b (Companies House) is free, and a flat figure would misquote it the moment it
# ships. Both default to SIGNALS_COST_MICROS.
# SIGNALS_NEWS_COST_MICROS=1000         # indicative per Serper /news query (~$0.001)
# SIGNALS_WEB_SEARCH_COST_MICROS=1000   # indicative per Serper /search query (~$0.001)
# Companies House filings as signals (S13b). **No API key of its own** — it reuses Lead Sourcing's
# COMPANIES_HOUSE_API_KEY and its circuit breaker, because the registry rate-limits per key and one
# quota deserves one circuit. Free, and the only source with no AI cost either.
# SIGNALS_CH_FILINGS_PER_ENTITY=25      # filing history read per account per run (API caps at 100)
# SIGNALS_CH_RECENCY_DAYS=30            # how old a filing may be; its own window, not Serper's tbs
# SIGNALS_CH_RESOLVE_PER_RUN=10         # name->number lookups per run; most resolve free from leads
#
# RSS/Atom feeds (S13b) — the one source whose address a customer supplies, so every value is a
# bound on an outbound request. The SSRF guard itself is not configurable.
# SIGNALS_FEED_TIMEOUT=10
# SIGNALS_FEED_CONNECT_TIMEOUT=5
# SIGNALS_FEED_RETRY_TIMES=1            # one, not two: a feed is somebody else's server
# SIGNALS_FEED_MAX_BYTES=2000000        # read off a streamed body
# SIGNALS_FEED_MAX_ITEMS=40             # entries taken from one poll
# SIGNALS_FEED_MIN_POLL_MINUTES=60      # politeness floor, per team AND feed URL (see below)
# SIGNALS_FEED_VALIDATOR_TTL_DAYS=30    # how long an ETag is kept for the conditional GET
#                                       # The floor and the ETag are cached per **team** and URL,
#                                       # which the S13b review made a tenancy rule: keyed by URL
#                                       # alone, one team's poll of a public newsletter returned
#                                       # the articles and every other team got a 304 and nothing.
#                                       # A preview uses neither, so it cannot blind a first run.
# SIGNALS_FEED_MAX_PER_TEAM=10          # standing outbound requests one team may configure
# SIGNALS_FEED_USER_AGENT="AlimaProspects/1.0 (+signals)"
#
# Inbound events (S13b, ADR 0023 §7) — POST /api/v1/signal-events. The HMAC, the constant-time
# comparison and the fields a caller may not set are deliberately not configurable.
# SIGNALS_WEBHOOK_WINDOW_DAYS=7         # how old a stored event may be and still reach a run;
#                                       # MUST stay below the 30-day rejection memory
# SIGNALS_WEBHOOK_MAX_PER_RUN=50        # events one run reads for one type. Counts only events
#                                       # not already classified (S13b review): spent on the
#                                       # newest fifty whatever their state, a 200-event burst
#                                       # lost 150 of them silently. An event the *classifier*
#                                       # refused still occupies a slot until the window passes
#                                       # it, which is the one case this is the lever for.
# SIGNALS_WEBHOOK_TIMESTAMP_TOLERANCE=300   # seconds of clock skew allowed, each way
# SIGNALS_WEBHOOK_RATE_LIMIT=120        # per team per minute, on its own bucket
# SIGNALS_WEBHOOK_RETENTION_DAYS=30     # how long signals:prune keeps the received row
# SIGNALS_RUN_RATE_LIMIT=10         # "Run now" triggers per member per minute (S5)
# SIGNALS_MAX_DEFINITIONS_PER_TEAM=25   # cap on a team's own signal types (S7); presets don't count
# SIGNALS_MAX_QUERIES_PER_RUN=40        # most paid searches one run of one watch may make (S7)
# SIGNALS_MAX_WATCHES_PER_TEAM=10   # cap on watches per team (S6)
# SIGNALS_MIN_CONFIDENCE=60         # AI keep-threshold (S3)
# SIGNALS_MIN_RELEVANCE=40          # AI keep-threshold (S3)
# The builder (S9). A preview is a user-triggered spend loop, so it has three independent caps:
# one press, one member per hour, and the whole team per day — each fails differently (ADR 0020).
# SIGNALS_PREVIEW_MAX_QUERIES=4          # paid searches one preview may make; a preview is a sample
# SIGNALS_PREVIEW_RESULTS_PER_QUERY=10   # headlines per sample query, smaller than a real run's
# SIGNALS_PREVIEW_RATE_LIMIT=10          # previews per member per hour
# SIGNALS_PREVIEW_DAILY_BUDGET_MICROS=500000  # per team per day, over the signal_previews ledger
# SIGNALS_COMPOSER_RATE_LIMIT=10         # AI drafts per member per hour (no team-wide cap until S16)
# SIGNALS_COMPOSER_MAX_BRIEF=1000        # characters of the member's own description (ADR 0017)
#
# Playbooks (S14, ADR 0024): a rule that acts on a signal arriving. Every number here is a brake,
# and they are per *thing being spent* rather than one global cap, because mass conversion is a
# billing problem and mass drafting is an AI-spend problem. The two that cost money are the
# tightest. A playbook can prepare an approach and never send one, which is deliberately not
# configurable (docs/compliance.md 3.12).
# SIGNALS_MAX_PLAYBOOKS_PER_TEAM=10            # rules per team; each is evaluated against every signal
# SIGNALS_PLAYBOOK_MAX_ACTIONS=8               # steps one rule may carry
# SIGNALS_PLAYBOOK_MAX_SIGNALS_PER_RUN=200     # signals one job puts through the rules
# SIGNALS_PLAYBOOK_MAX_CONVERSIONS_PER_RUN=25  # leads one job may create, across every rule
# SIGNALS_PLAYBOOK_MAX_DRAFTS_PER_RUN=10       # drafts one job may write, across every rule
# SIGNALS_PLAYBOOK_DEFER_SECONDS=900          # how long a batch the ceilings deferred waits
# SIGNALS_PLAYBOOK_PREVIEW_DAYS=7              # how far back "what would this have done?" looks
# SIGNALS_PLAYBOOK_PREVIEW_SAMPLES=10          # examples it shows; it executes and spends nothing
# SIGNALS_PLAYBOOK_DRY_RUN_DAYS=7              # the rehearsal the screen suggests; copy, not a rule
#
# The signal round-up, and per-type return on investment (S15). The cap on how many events the
# digest names rather than counts; the window each type's figures are reported over; and the floor
# the retirement suggestion needs before it will say anything at all.
# SIGNALS_DIGEST_HIGHLIGHTS=3            # events the round-up names rather than counts (S15)
# SIGNALS_ROI_WINDOW_DAYS=60             # days of history behind each type's figures
# SIGNALS_ROI_RETIRE_ENABLED=true        # propose pausing a type that is not earning its keep
# SIGNALS_ROI_RETIRE_MINIMUM=30          # signals a type must have produced before we say anything
# SIGNALS_ROI_RETIRE_KEPT_FLOOR=0.1      # kept share at or below which a pause is proposed
#
# Retention (S6, extended across every table the feature has in S16). `signals:prune` is the one
# thing that deletes and `SignalRetention` is the one thing that decides; the windows are three
# different lengths because the tables answer three different questions, and the group a table is in
# matters more than its number. Records about a person get the shortest window the product can live
# with; cost history is kept in arrears because it names nobody; working state is swept when the
# thing it was about goes. See docs/compliance.md 5a.
# SIGNALS_RETENTION_DISMISSED_DAYS=90    # hard-delete dismissed signals after N days (S6)
# SIGNALS_RETENTION_UNACTIONED_DAYS=180  # hard-delete unactioned signals after N days (S6)
# SIGNALS_RETENTION_PREVIEW_DAYS=30      # preview ledger rows: a draft hash, counts and a cost
# SIGNALS_RETENTION_RUN_DAYS=400         # cost history. FINISHED runs only - a queued row is live
# SIGNALS_RETENTION_SPEND_DAYS=400       # the same cost history, per signal type
# SIGNALS_RETENTION_PLAYBOOK_RUN_DAYS=180 # what a rule did to a prospect's record
# SIGNALS_RETENTION_SOURCE_STAT_DAYS=180 # ROLLING, from last_seen_at: an outlet still being read
#                                        # is never swept, however old its row is
#
# A buying signal's shelf life for the ICP scorer (Q3). `MatchedLeadSignals` answers Scoring's
# LeadSignalSource from signals.matched_lead_id, which is what lets a `buying_signal` ICP criterion
# be judged by the rules rather than abstaining. A criterion phrased "recently raised funding" means
# recently; the retention windows above cut in first, so this is a ceiling rather than a promise.
# SIGNALS_SCORING_LEAD_SIGNAL_DAYS=365
#
# Clustering: one event, one card (S11). `cluster_before_ai` is where the AI saving comes from -
# one classification per story instead of one per article - and turning it off restores v1's
# behaviour exactly, which is why it is a flag rather than a rollback. The cards stay consolidated
# either way: that half is the subject-based cluster key, not this grouping. Similarity is Dice over
# the significant words of two headlines ("roughly this fraction in common"), with an absolute floor
# underneath because a ratio is most confident where it has least evidence. Both are deliberately
# strict - a false merge here decides which article the model reads.
# SIGNALS_CLUSTER_BEFORE_AI=true
# SIGNALS_CLUSTER_TITLE_SIMILARITY=0.6   # Dice over headline words; strict on purpose
# SIGNALS_CLUSTER_MIN_SHARED_TOKENS=3    # the floor under the ratio
#
# Remembering what the classifier rejected (S11), which closes the S3 trade-off: a weekly round-up
# inside the recency window cost an AI batch every single day it stayed there. Keyed by the article
# **and** the set of signal types that were offered, so adding a type asks again. Holds hashes, a
# verdict and counts - no headline, no URL, no name - which is why it is cheap to keep.
# SIGNALS_REMEMBER_REJECTIONS=true
# SIGNALS_REJECTION_RETENTION_DAYS=30    # how long a rejection is honoured AND kept (one number)
#
# Ranking (S12). The feed is ordered by `heat` — a deterministic 0-100 composite of eight
# components, each of which is **stored** beside the total so every card can show its working. The
# weights are here so they can be argued about with evidence rather than taste; a signal type may
# override any of them (`signal_definitions.score_weights`).
#
# Two rules the arithmetic follows, both borrowed from the lead scorer so the two scores in this
# product behave the same way: weights are **normalised, not summed** (heat is
# `contributed / assessed`, so changing one cannot inflate every signal), and **missing data is not
# a failure** (a component with nothing to judge leaves *both* sides of the average, so a thinly
# reported event is not marked down for being thinly reported).
#
# After changing any of these, run `php artisan signals:rescore --all` — the stored scores are the
# old weights' answers until something re-scores them. It is deliberately not scheduled: a nightly
# re-score would silently re-rank a team's feed every morning for reasons nobody could see.
# SIGNALS_WEIGHT_RELEVANCE=30            # what the AI thought — the only component that read the article
# SIGNALS_WEIGHT_CONFIDENCE=15
# SIGNALS_WEIGHT_RECENCY=20
# SIGNALS_WEIGHT_AMOUNT=10               # ranked against the team's own history, not an absolute
# SIGNALS_WEIGHT_SOURCE_AUTHORITY=10     # what this team has done with this outlet before
# SIGNALS_WEIGHT_SENIORITY=5
# SIGNALS_WEIGHT_CLUSTER_BREADTH=5       # how many outlets carried it (S11)
# SIGNALS_WEIGHT_ICP_FIT=15              # through Scoring's own criteria match, not a second one
# SIGNALS_RECENCY_HALF_LIFE_DAYS=7       # an event's value halves this often
# SIGNALS_AMOUNT_HISTORY_MINIMUM=5       # below this many deals, the amount component abstains
# SIGNALS_SOURCE_HISTORY_MINIMUM=5       # below this many outcomes, source authority abstains
# SIGNALS_BREADTH_SATURATION=6           # outlets beyond this say more about syndication than truth
#
# Tuning suggestions (S12): the advisor **proposes and never applies**. `signals:advise` runs
# weekly and writes rows a member accepts or declines on the watch settings screen; a declined
# suggestion is kept so it is never raised again. The thresholds are what stop it being a nag.
# SIGNALS_TUNING_MIN_OBSERVATIONS=8      # evidence a proposal needs before it is worth attention
# SIGNALS_TUNING_MIN_RATE=0.7            # how one-sided that evidence has to be
# SIGNALS_TUNING_MAX_OPEN=5              # a panel of thirty suggestions is a backlog
#
# Full-article fetch (S12) — **off by default**. For a signal the scorer already rates highly, read
# the publisher's page through the shared SSRF-safe fetcher and re-extract the amount, the names
# and the role from the full text. It stores the extracted fields and a timestamp and **never the
# article body**: retention and DSAR both get harder the moment the product keeps prose.
#
# Four things bound it when it is on, and `robots.txt` is the fifth. Turning it on **without**
# setting the monthly cap is the mistake to avoid — zero means uncapped, which is only safe while
# the feature itself is off.
# SIGNALS_ARTICLE_FETCH_ENABLED=false
# SIGNALS_ARTICLE_FETCH_MIN_HEAT=70            # only the signals somebody is going to read
# SIGNALS_ARTICLE_FETCH_MAX_PER_RUN=5          # one busy news day is not a hundred page fetches
# SIGNALS_ARTICLE_FETCH_MONTHLY_CAP_MICROS=0   # per team, calendar month in UTC; 0 = uncapped
# SIGNALS_ARTICLE_FETCH_COST_MICROS=2000       # metered onto the run's cost like every other spend
# SIGNALS_ARTICLE_FETCH_ROBOTS_TTL=86400       # one robots.txt per publisher per day
# SIGNALS_ARTICLE_FETCH_ROBOTS_ERROR_TTL=300   # a robots.txt we could not read is retried sooner

# Shared SSRF-safe web fetch (Core; used by Business Intelligence + Enrichment).
# All optional; config/web-fetch.php defaults shown.
# WEB_FETCH_TIMEOUT=10
# WEB_FETCH_CONNECT_TIMEOUT=5
# WEB_FETCH_MAX_BYTES=500000
# WEB_FETCH_MAX_CHARS=12000
# WEB_FETCH_USER_AGENT="AlimaProspectsBot/1.0 (+https://alimaprospects.com/bot)"

# Enrichment & Data Quality (Phase 8; all optional, config/enrichment.php defaults shown)
# ENRICHMENT_MAX_CONTACTS=10
#
# How ready a lead is to be CONTACTED (Q4): a second figure beside the fit score, answering the
# other question. The score says whether we should want them and is deliberately blind to missing
# data, which is why an A-grade lead can have no website, no contact and no routable email;
# readiness measures what we hold, so it is the one figure allowed to punish a gap. Weights are
# relative, not percentages - LeadReadiness normalises by the total of the ones in play, so adding
# a factor cannot inflate a lead and setting one to 0 switches that factor off entirely. The three
# contact factors together outweigh the four company ones on purpose: a complete company record you
# cannot write to is not a lead you can work.
# ENRICHMENT_READINESS_WEIGHT_WEBSITE=10
# ENRICHMENT_READINESS_WEIGHT_INDUSTRY=10
# ENRICHMENT_READINESS_WEIGHT_COMPANY_SIZE=5
# ENRICHMENT_READINESS_WEIGHT_LOCATION=10
# ENRICHMENT_READINESS_WEIGHT_CONTACT=25
# ENRICHMENT_READINESS_WEIGHT_ROUTABLE_EMAIL=25  # routable, never proven deliverable (ADR 0008)
# ENRICHMENT_READINESS_WEIGHT_NAMED_CONTACT=15   # info@ is a letterbox; a named mailbox answers
#
# Website resolution: a website-less lead (every Companies House record, many Places ones) has
# nothing to enrich, so enrichment searches for its homepage (Serper, reusing WEB_SEARCH_API_KEY)
# and trusts it only if the page's company matches the lead's name at/above the threshold; a miss is
# discarded, never pinned. Off with ENRICHMENT_RESOLVE_WEBSITES=false.
# ENRICHMENT_RESOLVE_WEBSITES=true
# ENRICHMENT_RESOLVE_MATCH_THRESHOLD=0.5
#
# Multi-page fetch: read the homepage plus the conventional contact/about pages (where emails live)
# and extract over the combined, capped text in ONE AI call. The homepage counts as one page.
# ENRICHMENT_MAX_PAGES=4
# ENRICHMENT_MAX_COMBINED_CHARS=18000
#
# Inferred contacts: when a page names people but states no routable email, guess one address per
# person from the company domain + the pattern ({first}/{last}/{f}/{l}), keep only the routable ones,
# and store them flagged inferred with a capped confidence that earns no readiness - a guess, since
# the MVP has no SMTP probe (ADR 0008). Off with ENRICHMENT_INFER_EMAILS=false.
# ENRICHMENT_INFER_EMAILS=true
# ENRICHMENT_INFERRED_EMAIL_PATTERN={first}.{last}
# ENRICHMENT_MAX_INFERRED_CONTACTS=3
# ENRICHMENT_INFERRED_EMAIL_CONFIDENCE=25

# Scoring & Matching (Phase 9; all optional, config/scoring.php defaults shown).
# The hybrid score blends the deterministic (ICP criteria) and qualitative (AI) halves by these
# weights; they are normalised by their sum, so 60/40 and 6/4 behave identically.
# SCORING_BLEND_DETERMINISTIC=0.6
# SCORING_BLEND_QUALITATIVE=0.4
# Minimum blended score (0-100) for each grade. Anything below the C threshold grades D.
# SCORING_GRADE_A=80
# SCORING_GRADE_B=60
# SCORING_GRADE_C=40
# Weight given to an ICP signal the team left unweighted.
# SCORING_DEFAULT_WEIGHT=50
# Manual re-scores one member may request per minute (each one spends AI credit).
# SCORING_RESCORE_RATE_LIMIT=10
# Leads per chunk when re-scoring a whole team after its ICP changed.
# SCORING_RESCORE_CHUNK=200
# How many recent scores the ICP calibration preview reads for its per-criterion picture
# (the grade mix is exact over every lead; this only caps the breakdown aggregation).
# SCORING_CALIBRATION_SAMPLE=500

# Leads Workspace (Phases 10/10b; all optional, config/leads-workspace.php defaults shown).
# The board a team starts with is `default_stages` in that config, not an env var.
# Most stages one team's board may hold.
# LEADS_MAX_STAGES=20
# Leads loaded per board column — the board is a summary, so a fuller column links to the list.
# LEADS_BOARD_COLUMN_LIMIT=25
# Most leads one bulk action may touch.
# LEADS_MAX_BULK=500
# Bulk requests (bulk action / CSV import / CSV export) one member may make per minute.
# LEADS_BULK_RATE_LIMIT=20
# CSV import/export limits.
# LEADS_CSV_MAX_UPLOAD_KB=5120
# LEADS_CSV_MAX_IMPORT_ROWS=2000
# LEADS_CSV_EXPORT_CHUNK=200

# Outreach (Phase 11). Sending off leaves drafting, copying and logging working — the member sends
# from their own mailbox instead — which is the right setting for a deployment with no verified
# sending domain. The envelope sender is ours, named for the team ("Acme Ltd via Alima"); a team's
# own sending domain is post-MVP (docs/modules/outreach.md).
# OUTREACH_SENDING_ENABLED=true
# OUTREACH_FROM_ADDRESS=      # defaults to MAIL_FROM_ADDRESS
# OUTREACH_FROM_VIA="via Alima"
# Where an opt-out reply goes. Platform-monitored, never a tenant mailbox: an opt-out has to reach
# the GLOBAL suppression list (docs/compliance.md §3.3). Defaults to MAIL_FROM_ADDRESS.
# OUTREACH_OPT_OUT_ADDRESS=
# The prospect-facing privacy notice, linked from every sent message (compliance.md §3.7). Leave
# unset and the footer links Alima's own hosted notice at /privacy — set this only to point
# somewhere else.
# OUTREACH_PRIVACY_NOTICE_URL=
# Per-member, per-minute caps. Drafting spends AI credit; sending spends sending reputation.
# OUTREACH_DRAFT_RATE_LIMIT=30
# OUTREACH_SEND_RATE_LIMIT=60
# RFC 8058 one-click unsubscribe (Phase 15). Off leaves the Phase 11 behaviour — a `mailto:`
# opt-out and no `List-Unsubscribe-Post`, which is what a deployment without the route published
# should send: advertising one-click against a mailto-only header is read as a bad signal.
# OUTREACH_UNSUBSCRIBE_ENABLED=true
# OUTREACH_UNSUBSCRIBE_LINK_DAYS=400   # somebody may unsubscribe from a year-old email
# OUTREACH_UNSUBSCRIBE_RATE_LIMIT=20   # per IP, per minute

# Compliance & Privacy (Phase 15). The retention windows and the privacy-notice particulars are
# LEGAL settings, which is why they are here rather than in code — counsel changes them in the
# environment. ⚖️ All of this is part of the pre-launch review (ADR 0007, docs/compliance.md §5).
#
# Retention: an untouched lead is DELETED after the first window; a worked one is ANONYMISED after
# the second (personal data removed, the company and the record of each approach kept). A team can
# set shorter windows in the product, and the sweep runs on the defaults until it does.
# COMPLIANCE_RETENTION_UNCONTACTED_DAYS=180
# COMPLIANCE_RETENTION_CONTACTED_DAYS=540
# COMPLIANCE_RETENTION_MIN_DAYS=30      # a team typing 7 has misread the field
# COMPLIANCE_RETENTION_MAX_DAYS=1825
# COMPLIANCE_RETENTION_CHUNK=200
# How long a signed legitimate-interest assessment stands before it must be re-affirmed, and the
# shortest answer that can be a considered one (the gate it opens is the lawful basis for every
# lead the team sources).
# COMPLIANCE_LIA_REVIEW_MONTHS=12
# COMPLIANCE_LIA_SECTION_LIMIT=4000
# COMPLIANCE_LIA_SECTION_MINIMUM=40
# Data-subject requests: the shortest query that can be about one person, and the result cap.
# COMPLIANCE_DSAR_MIN_QUERY=3
# COMPLIANCE_DSAR_MAX_RESULTS=200
# Team data export, per member per hour. It reads every table the team owns.
# COMPLIANCE_EXPORT_RATE_LIMIT=3
# The hosted privacy notice's particulars. ⚖️ These appear verbatim on a public page.
# COMPLIANCE_PRIVACY_CONTACT=          # defaults to OUTREACH_OPT_OUT_ADDRESS
# COMPLIANCE_HOSTING_LOCATION="Germany (EU)"
# COMPLIANCE_PRIVACY_VERSION=1.0
# COMPLIANCE_PRIVACY_UPDATED_ON=2026-10-30
# How long the compliance log is kept — the longest of any channel, because "did you honour the
# erasure, and when" is a question an authority may ask a year later.
# LOG_DAILY_DAYS_COMPLIANCE=90

# Billing (Stripe / Cashier) — Phase 16.
# The billable party is the TEAM, not the user: Cashier's customer columns live on `teams`.
#
# TWO SWITCHES, ANSWERING DIFFERENT QUESTIONS. Both default to on in config; set either to false
# here to turn it off for a deployment, and read `config/billing.php` before you do.
#
#   BILLING_STRIPE_ENABLED  — will we talk to Stripe at all? Off: checkout, the portal, plan swaps,
#                             cancellation, resumption and metered overage all refuse, and the
#                             webhook is rejected. Entitlement is UNTOUCHED — a team on Scale stays
#                             on Scale. The operator's own kill switch is ANDed with this, so
#                             either turns Stripe off and neither turns the other back on.
#   BILLING_ENFORCE_PLANS   — does a plan decide what a team may do? Off: Billing installs neither
#                             its plan capability gate nor its three allowance sources, so the
#                             permissive defaults the owning modules ship stand — every capability
#                             allowed, discovery unquotaed, seats unlimited. Off is NOT "everybody
#                             is on Free"; it is "nothing is gated on a plan". Suspension still
#                             bites, operator overrides still bite, and the AI credit allowance
#                             (`AI_CREDITS_MONTHLY_DEFAULT`) still applies — that one is a cost
#                             guard every tenant has had since Phase 6, not a plan feature.
#
# Neither implies the other: Stripe off with plans enforced is the invoiced-customer case the
# module was built for; both off is "we are not charging anybody yet".
BILLING_STRIPE_ENABLED=true
BILLING_ENFORCE_PLANS=true

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=gbp

# Stripe price ids. The defaults in config/billing.php are PLACEHOLDERS — the products do not exist
# in Stripe yet, so every environment that talks to Stripe for real must set these.
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_SCALE=price_...
# Enterprise has no public price; set this only once a per-customer price exists.
# STRIPE_PRICE_ENTERPRISE=
# Metered overage prices. NO placeholder default, unlike the three plan prices above: each must be
# a real Stripe price with a meter attached, and a fake one here would be attached to every checkout
# session as a second line item — so setting up the plan prices alone would still fail, pointing at
# a price nobody has heard of. Left unset, no metered item is attached: the plan prices work on
# their own, and overage is measured and capped but not billed. Leads bill per company, credits per
# thousand, signal searches per hundred (a Serper query costs a tenth of a penny, so per-query would
# be unreadable and per-thousand a line most teams never reach).
# STRIPE_PRICE_OVERAGE_LEADS=price_...
# STRIPE_PRICE_OVERAGE_CREDITS=price_...
# STRIPE_PRICE_OVERAGE_SIGNAL_QUERIES=price_...

# Plan shape. Prices are in MINOR UNITS (pence): 4900 = £49.00.
# BILLING_TRIAL_DAYS=14
# BILLING_TRIAL_PLAN=team            # the plan a card-less trial is entitled to
# BILLING_DEFAULT_PLAN=free          # where a team lands when the trial lapses
# BILLING_STARTER_AMOUNT=4900
# BILLING_TEAM_AMOUNT=12900
# BILLING_SCALE_AMOUNT=37900
# BILLING_STARTER_LEADS=500
# BILLING_TEAM_LEADS=2000
# BILLING_SCALE_LEADS=8000
# BILLING_STARTER_CREDITS=20000
# BILLING_TEAM_CREDITS=75000
# BILLING_SCALE_CREDITS=250000
# BILLING_FREE_LEADS=25
# BILLING_FREE_CREDITS=2000
# How far past the included allowance a metered plan may run before work stops outright. A plan
# with no ceiling is a way to hand a customer an invoice they never agreed to.
# BILLING_OVERAGE_MULTIPLIER=2.0
# BILLING_OVERAGE_LEAD_AMOUNT=8      # pence per extra company
# BILLING_OVERAGE_CREDIT_AMOUNT=120  # pence per extra 1,000 credits
# BILLING_OVERAGE_SIGNAL_QUERY_AMOUNT=40  # pence per extra 100 signal searches (S16)
# BILLING_SALES_EMAIL=sales@alimaprospects.com

# What a plan allows on Signals (S16). Eight figures per plan, read through
# `Signals\Contracts\SignalQuotaSource` and enforced by `SignalSpendGuard` at the point of spend —
# three standing ceilings (how many instructions to spend a team may keep), three monthly allowances
# (what they may spend in a calendar month, UTC) and two switches.
#
# **A key left out of a plan is not the same as setting it to nothing.** An absent key means the
# plan has taken no position and Signals' own floor in `config/signals.php` stands; a null in config
# means the plan declares *unlimited* and wins over that floor; a number is a limit. Which is why
# the Enterprise plan spells all eight out rather than omitting them.
#
# Only `monthly_source_queries` is also a `BillingMetric`, so it is the only one that is metered,
# honours BILLING_OVERAGE_MULTIPLIER and warns a team near its ceiling. Nobody is billed for having
# a fourth watchlist.
#
# Free and Starter carry small numbers rather than none because Signals is not on those plans at
# all — these are what an operator's capability override would entitle a pilot to (ADR 0015).
# BILLING_FREE_SIGNAL_TYPES=3
# BILLING_FREE_SIGNAL_WATCHES=1
# BILLING_FREE_SIGNAL_ACCOUNTS=10
# BILLING_FREE_SIGNAL_QUERIES=100
# BILLING_FREE_SIGNAL_PREVIEWS=20
# BILLING_FREE_SIGNAL_ARTICLE_MICROS=0
# BILLING_STARTER_SIGNAL_TYPES=5
# BILLING_STARTER_SIGNAL_WATCHES=2
# BILLING_STARTER_SIGNAL_ACCOUNTS=25
# BILLING_STARTER_SIGNAL_QUERIES=600
# BILLING_STARTER_SIGNAL_PREVIEWS=60
# BILLING_STARTER_SIGNAL_ARTICLE_MICROS=0
# The first plan the price list promises Signals on, so this block is the shape of the offer.
# BILLING_TEAM_SIGNAL_TYPES=15
# BILLING_TEAM_SIGNAL_WATCHES=5
# BILLING_TEAM_SIGNAL_ACCOUNTS=100
# BILLING_TEAM_SIGNAL_QUERIES=2000
# BILLING_TEAM_SIGNAL_PREVIEWS=200
# BILLING_TEAM_SIGNAL_ARTICLE_MICROS=100000
# BILLING_TEAM_SIGNAL_PLAYBOOKS=true
# BILLING_TEAM_SIGNAL_WEBHOOK=true
# BILLING_SCALE_SIGNAL_TYPES=25
# BILLING_SCALE_SIGNAL_WATCHES=15
# BILLING_SCALE_SIGNAL_ACCOUNTS=250
# BILLING_SCALE_SIGNAL_QUERIES=10000
# BILLING_SCALE_SIGNAL_PREVIEWS=600
# BILLING_SCALE_SIGNAL_ARTICLE_MICROS=500000
# BILLING_SCALE_SIGNAL_PLAYBOOKS=true
# BILLING_SCALE_SIGNAL_WEBHOOK=true

# ---------------------------------------------------------------------------
# Testing against MySQL (Signals S16)
# ---------------------------------------------------------------------------
#
# The suite runs on in-memory SQLite, which says nothing about whether a query runs on MySQL — see
# memory/sqlite-tests-mysql-prod.md, and the `LIKE ... ESCAPE` backslash that passed every test and
# would have failed every production query. `tests/Feature/Signals/SignalsMysqlDialectTest.php`
# exercises the raw `LIKE`s, the `whereDate` and the nested `orWhere` group against the real engine
# and is SKIPPED unless this names a throwaway schema, because it calls `migrate:fresh`.
#
#   mysql -e "create database alima_mysql_test"
#   SIGNALS_MYSQL_TEST_DATABASE=alima_mysql_test php artisan test tests/Feature/Signals/SignalsMysqlDialectTest.php
#
# It reads DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD like any other connection.
# SIGNALS_MYSQL_TEST_DATABASE=

# ---------------------------------------------------------------------------
# Monitoring (Phase 20, ADR 0017) — three Sentry projects and one dashboard.
# ---------------------------------------------------------------------------
#
# A DSN authorises *writing* an event to a project and nothing else, which is why the browser one
# is safe to serve to a page and the mobile one is safe to ship inside a bundle. The token that
# would *read* a project is not in this application at all.
#
# Three separate projects on purpose: a 500 in a queue worker, a TypeError in a browser and a crash
# on a three-year-old handset are triaged by different people with different questions, and one
# project means none of the three release lists is readable.
SENTRY_LARAVEL_DSN=
# Served to the browser in the Inertia props (`HandleInertiaRequests::observability()`) rather than
# built into the bundle, so one value covers staging and production with no rebuild — and the
# Content-Security-Policy derives the ingest origin from this same value, so the policy can never
# allow a host the SDK does not post to. Empty means the browser SDK is never even imported.
SENTRY_DSN_FRONTEND=
# The mobile app reads its own `VITE_SENTRY_DSN` from `mobile/.env` at build time (a phone has no
# Inertia). This is here so the three are findable in one place.
# SENTRY_DSN_MOBILE=
#
# Traces, not errors. 0.2 on the backend; lower in the browser, because a trace costs the visitor's
# bandwidth as well as our quota.
SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_FRONTEND_TRACES_SAMPLE_RATE=0.1
#
# The deploy's commit, set by the release pipeline (Phase 21). Without it every error in Sentry
# belongs to "no release", and "did this start with yesterday's deploy" has no answer.
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=
#
# **Leave both of these alone.** They are two separate controls and each covers what the other does
# not — which is the mistake the Phase 20 security review found in this file's first version.
#
# `send_default_pii=true` attaches the cookies, the request headers and the visitor's IP address.
# SENTRY_SEND_DEFAULT_PII=false
#
# And the **request body** is this one, not that one. The SDK's own default is `medium`: ten
# kilobytes of body on every error event. In this product that body is the prospect record somebody
# was saving — `name`, `company_name`, `notes` — which are not credential-shaped words and so are on
# no deny-list, and which are third-party personal data this company is a *processor* for.
# `security:posture` fails on anything but `none`/`never`.
# SENTRY_MAX_REQUEST_BODY_SIZE=none
#
# Session replay records the screen of somebody working a list of named prospects, which is
# third-party personal data this product is a processor for (docs/compliance.md). Off, and a
# decision to change that belongs with the privacy notice open.
# SENTRY_FRONTEND_REPLAY_SAMPLE_RATE=0
#
# The live operator dashboard at `/pulse` — behind the admin panel's own door: platform admin or
# 404, enforced 2FA, the optional IP allowlist, then the `viewPulse` gate (`operations.manage`).
PULSE_ENABLED=true
# The AI usage card's recorder. Live spend, failures and latency per prompt — **not** the billing
# figure, which is the `ai_requests` ledger behind `/admin`.
# PULSE_AI_USAGE_ENABLED=true

# ---------------------------------------------------------------------------
# Response security headers (Phase 20, ADR 0017)
# ---------------------------------------------------------------------------
#
# Defaults are the secure ones; every key here exists to loosen something for an environment that
# needs it, and `php artisan security:posture --strict` fails on the ones that must not be loose in
# production. See `config/security.php`.
#
# The CSP is nonce-based and is **not** emitted while the Vite dev server is running — a nonce
# policy only holds if every inline script and style carries one, and `npm run dev` injects
# component styles from JavaScript with no nonce to carry.
# SECURITY_CSP_ENABLED=true
# Report-only is how a tightened policy is rolled out: deploy it, read the violations, then turn
# this off. Never the steady state.
# SECURITY_CSP_REPORT_ONLY=false
# SECURITY_CSP_REPORT_URI=
# Comma-separated extra origins, for a CDN in front of `public/` (Phase 21).
# SECURITY_CSP_EXTRA_CONNECT_SRC=
# SECURITY_CSP_EXTRA_SCRIPT_SRC=
# SECURITY_CSP_EXTRA_IMG_SRC=
#
# HSTS follows the *connection*, not the environment: it is never sent over plain HTTP, so a local
# `.test` domain cannot pin itself to HTTPS by accident. `preload` is off because it is a one-way
# door — removal takes months — and belongs to the deployment decision, not to a default.
# SECURITY_HSTS_ENABLED=true
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_HSTS_PRELOAD=false

# Notifications (Phase 12).
# How long the aggregated "new strong matches" announcement waits, and so the window it counts
# over. A discovery run can grade fifty leads a minute; this turns that into one notification.
# NOTIFICATIONS_TOP_LEADS_WINDOW=15
# `notifications:prune` deletes READ notifications older than this. Unread ones are kept whatever
# their age — a member who has not looked has not been told.
# NOTIFICATIONS_RETENTION_READ_DAYS=90
# Push tokens nothing has been sent to since are swept: a stale token is a send that goes nowhere.
# NOTIFICATIONS_RETENTION_DEVICE_DAYS=180
# NOTIFICATIONS_BELL_LIMIT=15

# Mobile push — Firebase Cloud Messaging **HTTP v1**, which authenticates with a service account.
# Download the service-account JSON from the Firebase console and point FCM_CREDENTIALS at it
# (keep the file out of the repo). With nothing configured, push is simply not sent; the in-app and
# email channels are unaffected.
#
# This is the SERVER half. The app needs the matching client config — `google-services.json` from
# the same Firebase project, at `mobile/android/app/` — and that is the usual reason push appears to
# register and then nothing arrives. Both steps are in `docs/runbooks/mobile-dev.md` §3.5.
# The mobile app's own build-time variables live in `mobile/.env` (see `mobile/.env.example`), not
# here: this file is read by Laravel, and Vite in `/mobile` reads its own.
FCM_CREDENTIALS=
# Optional — otherwise taken from the service-account file.
FCM_PROJECT_ID=
# FCM_TIMEOUT=10
# FCM_CONNECT_TIMEOUT=5
#
# NOTE: FCM_SERVER_KEY is the **legacy** credential. Google retired the legacy /fcm/send endpoint
# in June 2024 and it is no longer accepted — kept here only so an existing .env is not confusing.
FCM_SERVER_KEY=
# APNs direct (unused: Firebase relays to APNs, so one provider covers iOS too).
APNS_KEY_ID=
APNS_TEAM_ID=

# AI Insights (Phase 14). Every key here is about one of the two ways this feature fails: noise and
# cost. See docs/modules/ai-insights.md.
#
# The hour (0-23) in the **team's own timezone** at which the day's insights are generated.
# `insights:generate` runs hourly and fires per team when its local clock reaches this.
# INSIGHTS_GENERATE_AT_HOUR=7
#
# How long a lead the team has *started* may sit untouched before it is going cold, and how many
# companies the alert names (the count on the card is always the real total).
# INSIGHTS_STALE_AFTER_DAYS=14
# INSIGHTS_STALE_MAX_ITEMS=5
#
# How long today's call list is. Five is a morning's work; twenty is a list nobody starts.
# INSIGHTS_CONTACT_TODAY_MAX_ITEMS=5
#
# The one AI call this module makes, at most once per team per day. Off means the stale-lead alert
# and the call list still run daily and the feed simply has no commentary — which is also what
# happens on a provider outage. A deployment watching its margin can switch it off without losing
# the feature.
# INSIGHTS_AI_ENABLED=true
# INSIGHTS_AI_MAX_ITEMS=3
#
# `insights:prune`. Insights are derived data that goes stale fast — a week-old "contact these five
# today" is misleading rather than merely old — so they are swept harder than anything else.
# Dismissed is measured from the dismissal, unactioned from the generation.
# INSIGHTS_RETENTION_DISMISSED_DAYS=30
# INSIGHTS_RETENTION_UNACTIONED_DAYS=60

# Admin panel (Phase 19a, ADR 0014). The internal operations panel at /admin, on a platform-admin
# identity (`users.admin_role`) rather than a second auth guard. See docs/runbooks/admin-panel.md.
#
# Where the panel is mounted. Not a security measure — non-operators get a 404 wherever it lives —
# but a non-default path keeps it out of the logs of every scanner on the internet.
# ADMIN_PATH=admin
#
# Optional network restriction, comma-separated, CIDR for IPv4 and IPv6. **Empty by default on
# purpose:** an allowlist configured wrong locks the ops team out of the tool they would use to fix
# it, and a developer on a home connection has no fixed address to put in it. Set it in production.
# ADMIN_IP_ALLOWLIST=203.0.113.0/24,2001:db8::/32
#
# A platform operator must have confirmed two-factor authentication. One super-admin credential
# reads every tenant's data in the product, so a password alone is the wrong lock.
#
# **This is not a deployment option.** It exists so a test suite and a first walk through the panel
# do not have to solve a TOTP challenge; production keeps it true, and `php artisan
# security:posture --strict` fails the deploy if it is false (Phase 20).
# ADMIN_REQUIRE_TWO_FACTOR=true
#
# Requests per minute per operator, for the whole panel — separate from the app's own limiter.
# Paging a cross-tenant index legitimately makes far more requests than working one team, and a
# compromised operator session is the one credential here where a scripted scrape is worth writing.
# ADMIN_RATE_LIMIT=240
#
# How long an impersonated session lasts before the clock ends it. A forgotten impersonation is a
# customer's account left open in somebody's browser.
# ADMIN_IMPERSONATION_TTL=60
#
# `SuperAdminSeeder` plants super@admin.com with a known password, so it refuses to run in
# production unless this is true **and** `--force` was passed. Leave it alone: a seeder that plants
# a known password on a public host is not a convenience, it is the breach. Create real operator
# accounts by registering normally and having a super admin set the role.
# ADMIN_SEED_ALLOW_PRODUCTION=false

# -----------------------------------------------------------------------------
# Pre-launch feature flags (pre-launch.md Appendix A, ADR 0026 §4)
# -----------------------------------------------------------------------------
# Each of these answers *is this code finished enough to be seen* — not *is it part of the plan
# this team pays for*, which is `Core\Enums\Capability` behind `CapabilityGate` (ADR 0015).
# Defaults live in config/prelaunch.php and resolve per **team** through Pennant, so a pilot is a
# row in `features` rather than a deploy. Each flag is deleted once its feature is live.
#
# PL1 — dated, sourced evidence behind every lead, with a confidence and a why-now line. While it
# is off, the calculation still runs (so the backfill and the first enabled team are cheap) but
# nothing is hidden and no panel is rendered.
# PRELAUNCH_WHY_NOW=false

# -----------------------------------------------------------------------------
# Lead evidence and "why now" (PL1, ADR 0028)
# -----------------------------------------------------------------------------
# Everything about the arithmetic is tunable from config/evidence.php; the keys below are the ones
# worth reaching for. Changing a reliability affects **new** evidence only: the weight is stamped
# on the row at capture, deliberately, so re-weighting a source never restates what the feed
# already explained (ADR 0022).
#
# The line below which a lead is hidden from the list by default. A team can move its own line
# between 30 and 90 on the Team settings screen; a null there means this value, which is what makes
# changing this move every team that never expressed a preference.
# EVIDENCE_MIN_CONFIDENCE=50
#
# How much a source's word is worth before age is taken off it, 0–100. A source with no entry
# scores EVIDENCE_RELIABILITY_DEFAULT, and `EvidenceReliabilityTest` fails if a shipped source has
# no weight — so this is the file to edit when a new provider lands, not a thing to discover later.
# EVIDENCE_RELIABILITY_DEFAULT=40
# EVIDENCE_RELIABILITY_COMPANIES_HOUSE=95
# EVIDENCE_RELIABILITY_NEWS=60
#
# Days for a kind of fact to lose half its weight, measured from when the event **happened**.
# EVIDENCE_HALF_LIFE_SIGNAL=30
