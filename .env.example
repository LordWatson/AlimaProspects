APP_NAME=AlimaProspects
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://alimaprospects.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alimaprospects
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. `log` locally (everything lands in storage/logs); `resend` everywhere that actually
# sends, which is what Outreach (Phase 11) and the Notifications digests go out over.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Must be an address on a domain verified in Resend, or every send is rejected by the provider.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (the mail provider). Required when MAIL_MAILER=resend.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ───────────────────────────────────────────────────────────────
# AlimaProspects — project configuration
# (Horizon runs only on Linux prod/CI; locally use `php artisan queue:work`.)
# For production set QUEUE_CONNECTION=redis, CACHE_STORE=redis, SESSION_DRIVER=redis.
# ───────────────────────────────────────────────────────────────

# Realtime (Reverb) — generate per-environment keys with `php artisan reverb:install`.
# These local defaults are safe for dev; production MUST use unique generated secrets.
REVERB_APP_ID=local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# AI Platform (default provider: Anthropic Claude, behind our AiClient — ADR 0005)
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_URL=https://api.anthropic.com/v1
AI_MODEL_REASONING=claude-sonnet-5-5
AI_MODEL_CHEAP=claude-haiku-5-5
# Per-team monthly AI allowance. 1 credit = AI_MICROS_PER_CREDIT cost micro-units (1000 ≈ $0.001),
# so 100000 credits ≈ $100/month. Replaced by plan allowances in Billing (Phase 16).
AI_MONTHLY_CREDIT_DEFAULT=100000
# AI_MICROS_PER_CREDIT=1000
# Generation + reliability tuning (sensible defaults in config/ai-platform.php):
# AI_MAX_TOKENS=2048
# AI_TEMPERATURE=0.2
# AI_TIMEOUT=60
# AI_SCHEMA_RETRIES=1
# AI_CACHE_ENABLED=true
# AI_CACHE_STORE=
# AI_CACHE_TTL=3600

# Lead-sourcing & enrichment providers (ADR 0008)
COMPANIES_HOUSE_API_KEY=
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=
# Lead-sourcing run + HTTP tuning (all optional; config/lead-sourcing.php defaults shown)
# LEAD_SOURCING_DEFAULT_LIMIT=25
# LEAD_SOURCING_MAX_LIMIT=100
# LEAD_SOURCING_CB_THRESHOLD=5
# LEAD_SOURCING_CB_COOLDOWN=60
# COMPANIES_HOUSE_TIMEOUT=10
# COMPANIES_HOUSE_CONNECT_TIMEOUT=5
# COMPANIES_HOUSE_RETRY_TIMES=2
# GOOGLE_PLACES_COST_MICROS=32000   # indicative per Text Search request (~$0.032)
# WEB_SEARCH_COST_MICROS=3000       # indicative per query (~$0.003)

# Signals (trigger-event prospecting, ADR 0011). Reuses WEB_SEARCH_API_KEY / WEB_SEARCH_BASE_URL
# above for Serper /news. All below optional; config/signals.php defaults shown.
# SIGNALS_SERPER_TIMEOUT=10
# SIGNALS_SERPER_CONNECT_TIMEOUT=5
# SIGNALS_SERPER_RETRY_TIMES=2
# SIGNALS_SERPER_RETRY_SLEEP_MS=250
# SIGNALS_CB_THRESHOLD=5
# SIGNALS_CB_COOLDOWN=60
# SIGNALS_RESULTS_PER_QUERY=20
# SIGNALS_RECENCY=qdr:w             # Serper tbs recency window (past week)
# SIGNALS_HL=en                     # results language (v1: English only)
# SIGNALS_COST_MICROS=1000          # indicative per /news query (~$0.001)
# SIGNALS_RUN_RATE_LIMIT=10         # "Run now" triggers per member per minute (S5)
# SIGNALS_MAX_WATCHES_PER_TEAM=10   # cap on watches per team (S6)
# SIGNALS_MIN_CONFIDENCE=60         # AI keep-threshold (S3)
# SIGNALS_MIN_RELEVANCE=40          # AI keep-threshold (S3)
# SIGNALS_RETENTION_DISMISSED_DAYS=90    # hard-delete dismissed signals after N days (S6)
# SIGNALS_RETENTION_UNACTIONED_DAYS=180  # hard-delete unactioned signals after N days (S6)

# Shared SSRF-safe web fetch (Core; used by Business Intelligence + Enrichment).
# All optional; config/web-fetch.php defaults shown.
# WEB_FETCH_TIMEOUT=10
# WEB_FETCH_CONNECT_TIMEOUT=5
# WEB_FETCH_MAX_BYTES=500000
# WEB_FETCH_MAX_CHARS=12000
# WEB_FETCH_USER_AGENT="AlimaProspectsBot/1.0 (+https://alimaprospects.com/bot)"

# Enrichment & Data Quality (Phase 8; all optional, config/enrichment.php defaults shown)
# ENRICHMENT_MAX_CONTACTS=10

# Scoring & Matching (Phase 9; all optional, config/scoring.php defaults shown).
# The hybrid score blends the deterministic (ICP criteria) and qualitative (AI) halves by these
# weights; they are normalised by their sum, so 60/40 and 6/4 behave identically.
# SCORING_BLEND_DETERMINISTIC=0.6
# SCORING_BLEND_QUALITATIVE=0.4
# Minimum blended score (0-100) for each grade. Anything below the C threshold grades D.
# SCORING_GRADE_A=80
# SCORING_GRADE_B=60
# SCORING_GRADE_C=40
# Weight given to an ICP signal the team left unweighted.
# SCORING_DEFAULT_WEIGHT=50
# Manual re-scores one member may request per minute (each one spends AI credit).
# SCORING_RESCORE_RATE_LIMIT=10
# Leads per chunk when re-scoring a whole team after its ICP changed.
# SCORING_RESCORE_CHUNK=200

# Leads Workspace (Phases 10/10b; all optional, config/leads-workspace.php defaults shown).
# The board a team starts with is `default_stages` in that config, not an env var.
# Most stages one team's board may hold.
# LEADS_MAX_STAGES=20
# Leads loaded per board column — the board is a summary, so a fuller column links to the list.
# LEADS_BOARD_COLUMN_LIMIT=25
# Most leads one bulk action may touch.
# LEADS_MAX_BULK=500
# Bulk requests (bulk action / CSV import / CSV export) one member may make per minute.
# LEADS_BULK_RATE_LIMIT=20
# CSV import/export limits.
# LEADS_CSV_MAX_UPLOAD_KB=5120
# LEADS_CSV_MAX_IMPORT_ROWS=2000
# LEADS_CSV_EXPORT_CHUNK=200

# Outreach (Phase 11). Sending off leaves drafting, copying and logging working — the member sends
# from their own mailbox instead — which is the right setting for a deployment with no verified
# sending domain. The envelope sender is ours, named for the team ("Acme Ltd via Alima"); a team's
# own sending domain is post-MVP (docs/modules/outreach.md).
# OUTREACH_SENDING_ENABLED=true
# OUTREACH_FROM_ADDRESS=      # defaults to MAIL_FROM_ADDRESS
# OUTREACH_FROM_VIA="via Alima"
# Where an opt-out reply goes. Platform-monitored, never a tenant mailbox: an opt-out has to reach
# the GLOBAL suppression list (docs/compliance.md §3.3). Defaults to MAIL_FROM_ADDRESS.
# OUTREACH_OPT_OUT_ADDRESS=
# The hosted prospect-facing privacy notice, linked from every sent message (compliance.md §3.7).
# OUTREACH_PRIVACY_NOTICE_URL=
# Per-member, per-minute caps. Drafting spends AI credit; sending spends sending reputation.
# OUTREACH_DRAFT_RATE_LIMIT=30
# OUTREACH_SEND_RATE_LIMIT=60

# Billing (Stripe / Cashier) — wired in the Billing phase
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=gbp

# Monitoring
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
PULSE_ENABLED=true

# Notifications (Phase 12).
# How long the aggregated "new strong matches" announcement waits, and so the window it counts
# over. A discovery run can grade fifty leads a minute; this turns that into one notification.
# NOTIFICATIONS_TOP_LEADS_WINDOW=15
# `notifications:prune` deletes READ notifications older than this. Unread ones are kept whatever
# their age — a member who has not looked has not been told.
# NOTIFICATIONS_RETENTION_READ_DAYS=90
# Push tokens nothing has been sent to since are swept: a stale token is a send that goes nowhere.
# NOTIFICATIONS_RETENTION_DEVICE_DAYS=180
# NOTIFICATIONS_BELL_LIMIT=15

# Mobile push — Firebase Cloud Messaging **HTTP v1**, which authenticates with a service account.
# Download the service-account JSON from the Firebase console and point FCM_CREDENTIALS at it
# (keep the file out of the repo). With nothing configured, push is simply not sent; the in-app and
# email channels are unaffected.
FCM_CREDENTIALS=
# Optional — otherwise taken from the service-account file.
FCM_PROJECT_ID=
# FCM_TIMEOUT=10
# FCM_CONNECT_TIMEOUT=5
#
# NOTE: FCM_SERVER_KEY is the **legacy** credential. Google retired the legacy /fcm/send endpoint
# in June 2024 and it is no longer accepted — kept here only so an existing .env is not confusing.
FCM_SERVER_KEY=
# APNs direct (unused: Firebase relays to APNs, so one provider covers iOS too).
APNS_KEY_ID=
APNS_TEAM_ID=
