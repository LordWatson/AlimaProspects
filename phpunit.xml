<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The whole suite in one process needs more than the 128M default, and `artisan test`
             spawns Pest as a child process that a `-d memory_limit=` on the parent never reaches.
             Setting it here applies wherever the suite is run from — `composer test`,
             `vendor/bin/pest`, or CI. -->
        <ini name="memory_limit" value="2G"/>

        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Billing (Phase 16). The suite must never reach Stripe: the gateway is faked, and
             these three make sure nothing falls through to a developer's real keys. An empty
             webhook secret also stands Cashier's signature middleware down, which is what lets the
             webhook tests post the payload Stripe would have posted. -->
        <env name="STRIPE_KEY" value=""/>
        <env name="STRIPE_SECRET" value=""/>
        <env name="STRIPE_WEBHOOK_SECRET" value=""/>
        <!-- The two switches that turn billing off are pinned **on** here, because the suite is
             what says they work. Both are deployment switches read from the environment, so a
             developer who sets either in their own `.env` — a perfectly reasonable thing to do
             while nobody is being charged — was turning off the behaviour thirty-odd tests exist
             to assert, and watching them fail for a reason that had nothing to do with their
             change. A test environment declares its own baseline rather than inheriting one.

             A variable already exported in the **shell** still wins, as it does for every other pin
             in this block — that is PHPUnit's behaviour without `force`, and leaving it that way is
             deliberate: passing an env var on the command line is how CI and tooling override a
             setting on purpose. `force="true"` was tried and is worse than it looks, which is
             worth knowing before somebody tries it again: PHPUnit applies it to `putenv` and
             `$_ENV` but not to `$_SERVER`, which Laravel's env repository also reads, so it takes
             effect for some files in a run and not others depending on what else has written to
             the environment first. Half a mechanism is worse than none.

             `PlanEnforcementSwitchTest` is the file that turns them off, deliberately and one test
             at a time, and puts these values back afterwards. -->
        <env name="BILLING_STRIPE_ENABLED" value="true"/>
        <env name="BILLING_ENFORCE_PLANS" value="true"/>
        <!-- The metered overage prices have no config default (a placeholder would be attached to
             every real checkout), so the suite supplies its own — otherwise the overage tests would
             be exercising the unconfigured no-op path and quietly asserting nothing. -->
        <env name="STRIPE_PRICE_OVERAGE_LEADS" value="price_test_overage_leads"/>
        <env name="STRIPE_PRICE_OVERAGE_CREDITS" value="price_test_overage_credits"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
