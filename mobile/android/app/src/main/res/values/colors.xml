<?xml version="1.0" encoding="utf-8"?>
<!--
    The brand, for the parts of the app Android draws rather than the WebView:
    the launcher icon, the splash, the status bar and the window background.

    From docs/brand/brand-tokens.md, by way of mobile/src/theme/brand.css. These
    are the only hex literals in the Android project; everything else references
    a name here.
-->
<resources>
    <!-- Palette (brand-tokens.md §1). -->
    <color name="alima_teal">#FF205557</color>
    <color name="alima_teal_60">#FF759491</color>
    <color name="alima_ink">#FF181723</color>
    <color name="alima_cream">#FFF5F2E8</color>
    <color name="alima_cream_surface">#FFFBFAF6</color>

    <!--
        The launcher icon's background layer. Deep Teal, with the cream panda on
        top: one of the approved colourways (§4), and the one that survives being
        masked into a circle, a squircle or a rounded square by whichever
        launcher the handset ships with.
    -->
    <color name="ic_launcher_background">@color/alima_teal</color>

    <!--
        The window background, visible for the instant before the WebView paints
        and behind an overscroll. Cream, so that moment is brand rather than a
        flash of white.
    -->
    <color name="alima_window_background">@color/alima_cream</color>

    <!--
        Theme.AppCompat's three required roles. Deep Teal is what the brand
        reserves for structure, and Ink is the dark variant — Signal Orange is
        decorative and is deliberately not an accent role here (§2.1).
    -->
    <color name="colorPrimary">@color/alima_teal</color>
    <color name="colorPrimaryDark">@color/alima_ink</color>
    <color name="colorAccent">@color/alima_teal</color>

    <!--
        The launch screen's mark. Its own colour rather than @color/colorPrimary,
        because that resolves to Teal 60 in the night theme — a *tint* of the
        logo, which §1.3 forbids. Teal on cream by day, cream on Ink by night:
        both approved colourways (§4).
    -->
    <color name="alima_splash_mark">@color/alima_teal</color>

    <!--
        The tint FCM applies to a notification's small icon. Teal, not Orange:
        a notification is a status, and Orange is never one.
    -->
    <color name="alima_notification_tint">@color/alima_teal</color>
</resources>
