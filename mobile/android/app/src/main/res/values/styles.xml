<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        The app's native theme. The WebView carries the brand itself
        (mobile/src/theme/brand.css); this is for the window around it — the
        splash, the window background behind an overscroll, and the system
        widgets Android draws for file pickers and permission dialogs.

        `DayNight` rather than `Light`, so a handset in dark mode does not get a
        light-themed system dialog in front of a dark app.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/alima_window_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- The launch screen, until the WebView has painted. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
