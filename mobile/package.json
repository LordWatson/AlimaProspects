{
    "name": "@alima/mobile",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Alima Prospects — the iOS + Android field companion (Capacitor + Ionic Vue), built against /api/v1.",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "check": "oxlint src --deny-warnings && oxfmt --check src",
        "check:fix": "oxlint src --fix && oxfmt src",
        "types:check": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "artwork": "node scripts/generate-native-artwork.mjs",
        "sync": "cap sync",
        "android": "cap run android",
        "android:open": "cap open android",
        "ios": "cap run ios",
        "ios:open": "cap open ios"
    },
    "dependencies": {
        "@capacitor/app": "^8.1.2",
        "@capacitor/core": "^8.5.3",
        "@capacitor/haptics": "^8.0.2",
        "@capacitor/keyboard": "^8.0.6",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/push-notifications": "^8.1.3",
        "@capacitor/status-bar": "^8.0.4",
        "@ionic/vue": "^9.0.9",
        "@ionic/vue-router": "^9.0.9",
        "@sentry/vue": "^11.10.0",
        "ionicons": "^8.1.0",
        "vue": "^3.5.13",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@capacitor/android": "^8.5.3",
        "@capacitor/cli": "^8.5.3",
        "@capacitor/ios": "^8.5.3",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.6",
        "jsdom": "^30.1.3",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
