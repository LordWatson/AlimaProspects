# Where the app looks for `/api/v1`. No trailing slash, no `/api/v1` suffix — the shared client
# adds that (`shared/api/client.ts`).
#
# Local development, in a desktop browser (`npm run dev`): the Herd domain.
VITE_API_URL=http://alimaprospects.test
#
# On an Android emulator, `alimaprospects.test` does not resolve and `localhost` is the emulator
# itself. Use the host loopback alias, or this machine's LAN address for a physical handset:
#   VITE_API_URL=http://10.0.2.2
#   VITE_API_URL=http://192.168.1.50
#
# On an iOS simulator the host's own DNS applies, so the Herd domain works as-is.
#
# In a development build the sign-in screen also carries a server field, so this is a default
# rather than the only way to change it. Release builds have no such field.
